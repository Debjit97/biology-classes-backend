      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Checks that the NestJS API process is responding.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is expected', function () {",
              "  pm.expect([200]).to.include(pm.response.code);",
              "});",
              "pm.test('Liveness payload is valid', function(){ pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
