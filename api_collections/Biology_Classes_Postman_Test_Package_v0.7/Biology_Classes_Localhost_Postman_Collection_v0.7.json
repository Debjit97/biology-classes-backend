        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "For Teacher/Student, stores accessToken and refreshToken automatically. For Admin, stores setupToken or challengeToken depending on MFA status.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is expected', function () {",
                  "  pm.expect([200,201,401]).to.include(pm.response.code);",
                  "});",
                  "let data = {}; try { data = pm.response.json(); } catch (e) {}",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "if (data.setupToken) pm.collectionVariables.set('setupToken', data.setupToken);",
                  "if (data.challengeToken) pm.collectionVariables.set('challengeToken', data.challengeToken);",
                  "if (data.mfaRequired) console.log('Admin MFA required: run Verify Admin MFA and provide a fresh 6-digit authenticator code.');\nif (data.mfaSetupRequired) console.log('Admin MFA enrollment required: run Start Admin MFA Setup, add the returned secret/otpauth URI to an authenticator app, then confirm enrollment.');"
                ]
              }
            }
          ]
        },
